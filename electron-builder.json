{
  "appId": "com.coffeedesk.app",
  "productName": "Coffee-Desk",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist-electron/main/**/*",
    "dist-electron/shared/**/*",
    "dist-electron/preload/**/*",
    "dist-electron/renderer/**/*",
    "!dist-electron/main/native/**/*"
  ],
  "extraMetadata": {
    "main": "dist-electron/main/index.js"
  },
  "win": {
    "icon": "assets/icon.ico",
    "target": "nsis"
  },
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "icon": "assets/icon.png",
    "target": "AppImage"
  },
  "copyright": "Copyright © 2026 Café - Sistemas & Softwares",
  "artifactName": "Coffee-Desk-${version}-${arch}-Setup.${ext}",
  "extraResources": [
    {
      "from": "dist-electron/main/native",
      "to": "native",
      "filter": [
        "CoffeeInput-v2.exe"
      ]
    },
    {
      "from": "node_modules/react/LICENSE",
      "to": "licenses/react-LICENSE.txt"
    },
    {
      "from": "node_modules/react-dom/LICENSE",
      "to": "licenses/react-dom-LICENSE.txt"
    },
    {
      "from": "node_modules/lucide-react/LICENSE",
      "to": "licenses/lucide-react-LICENSE.txt"
    },
    {
      "from": "assets/fonts",
      "to": "licenses/fonts",
      "filter": [
        "*-OFL.txt"
      ]
    }
  ],
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Coffee Desk",
    "installerLanguages": [
      "pt_BR"
    ],
    "installerIcon": "assets/icon.ico",
    "uninstallerIcon": "assets/icon.ico",
    "installerHeader": "build/installer/header.bmp",
    "installerSidebar": "build/installer/sidebar.bmp",
    "uninstallerSidebar": "build/installer/sidebar.bmp",
    "include": "build/installer/installer.nsh"
  },
  "publish": {
    "provider": "github",
    "owner": "sAlly-19",
    "repo": "Coffee-Desk"
  },
  "electronLanguages": [
    "pt-BR",
    "en-US"
  ],
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "onlyLoadAppFromAsar": true,
    "enableEmbeddedAsarIntegrityValidation": true
  }
}
