{
  "name": "coffee-desk-signaling",
  "version": "1.0.1",
  "description": "Servidor WebSocket de sinalização para emparelhamento Coffee-Desk",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "admin:create": "node --env-file-if-exists=.env dist/bootstrap-admin.js",
    "db:migrate": "node --env-file-if-exists=.env dist/migrate.js"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "embedded-postgres": "^18.6.0-beta.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "author": "Café - Sistemas & Softwares",
  "license": "MIT",
  "private": true
}
