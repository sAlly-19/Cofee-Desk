# Local operator only. Copy to an ignored .env file; never fill this tracked example.
NODE_ENV=production
PUBLIC_ORIGIN=https://YOUR-SERVICE.onrender.com
DATABASE_URL=postgresql://OWNER:REPLACE@DIRECT-HOST.neon.tech/neondb?sslmode=verify-full
ADMIN_ENCRYPTION_KEY=REPLACE_WITH_PRESERVED_RANDOM_64_HEX
# Render runtime instead uses coffee_runtime, not OWNER. RENDER_EXTERNAL_URL supplies origin.
HOST=0.0.0.0
TRUST_PROXY=true
PROXY_PROVIDER=render
ALLOWED_ORIGINS=file://,null
