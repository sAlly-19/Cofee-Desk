{
  "name": "coffee-desk",
  "productName": "Coffee-Desk",
  "version": "1.0.1",
  "description": "Coffee Desk — acesso remoto P2P para Windows",
  "author": "Café - Sistemas & Softwares",
  "license": "MIT",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:electron": "node --max-old-space-size=4096 ./node_modules/typescript/lib/tsc.js -p tsconfig.electron.json && node scripts/configure-client-build.js && node scripts/build-native.js && node scripts/bundle-preload.js",
    "build": "vite build && npm run build:electron",
    "package": "node scripts/assert-client-config.js && npm run build && electron-builder",
    "preview": "vite preview",
    "electron": "node scripts/start-electron.js",
    "electron:dev": "npm run build:electron && concurrently \"vite\" \"wait-on http://localhost:5173 && node scripts/start-electron.js\"",
    "signaling": "cd signaling-server && npm run dev",
    "lint": "eslint src signaling-server/src admin-panel/src --ext .ts,.tsx",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "screenshot": "node scripts/capture-screenshot.js",
    "verify:redesign": "node scripts/capture-screenshot.js --verify",
    "assets:icons": "node scripts/capture-screenshot.js --icons",
    "verify:startup": "npm run build:electron && node scripts/verify-startup.js",
    "package:win": "node scripts/assert-client-config.js && npm run build && electron-builder --win nsis --x64 --publish never",
    "release:source": "node scripts/prepare-source.js",
    "verify:package": "node scripts/verify-package.js",
    "release:checksums": "node scripts/release-checksums.js",
    "build:admin": "vite build --config admin-panel/vite.config.ts",
    "admin:dev": "vite --config admin-panel/vite.config.ts",
    "test:security": "node scripts/test-security.js",
    "dev:secure": "npm run build:server && npm run build:admin && node scripts/dev-security.js",
    "build:server": "npm run build --prefix signaling-server",
    "admin:create:local": "node scripts/create-local-admin.js",
    "test:admin": "node scripts/test-admin.js",
    "audit:security": "node scripts/audit-security.js",
    "build:hosting": "node scripts/build-hosting.js",
    "hosting:prepare-db": "node scripts/prepare-production.js",
    "hosting:probe": "node scripts/probe-hosting.js",
    "hosting:configure-client": "node scripts/configure-public-service.js",
    "test:hosting": "node scripts/test-hosting.js",
    "test:client-config": "node scripts/test-client-config.js",
    "verify:client-default": "node scripts/verify-client-default.js",
    "test:reliability": "node scripts/test-reliability.js",
    "test:recovery": "node scripts/test-recovery.js",
    "database:backup": "node scripts/database-recovery.js backup",
    "database:restore": "node scripts/database-recovery.js restore",
    "test:history": "node scripts/test-history.js",
    "test:update-ui": "node scripts/test-update-ui.js",
    "test:file-clipboard": "node scripts/test-file-clipboard.js",
    "test:pointer-capture": "node scripts/test-pointer-capture.js",
    "test:virtual-mouse": "node scripts/test-virtual-mouse.js"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.71.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "7zip-bin": "5.2.0",
    "concurrently": "^8.2.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.4",
    "vite": "^8.3.8",
    "wait-on": "^7.2.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  }
}
